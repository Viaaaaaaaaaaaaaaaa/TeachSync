<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Header Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Personal Profile"
        android:textColor="@color/text_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_gravity="start"
        android:layout_marginBottom="16dp" />

    <!-- Avatar Preview -->
    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_circle_icon">

        <ImageView
            android:id="@+id/imgEditAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile"
            android:contentDescription="Profile Photo Preview" />
    </FrameLayout>

    <!-- Photo Management Button (Vercel Cloud) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnUploadPhotoVercel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#26E39F"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/white"
                android:contentDescription="Upload Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Add / Change Photo from Gallery"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Name Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Full Name"
        android:textColor="@color/text_dark"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_gravity="start" />

    <EditText
        android:id="@+id/etEditName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input"
        android:hint="Enter name"
        android:autofillHints="name"
        android:inputType="textPersonName"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_dark"
        android:textSize="14sp" />

    <!-- Age Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Age"
        android:textColor="@color/text_dark"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_gravity="start" />

    <EditText
        android:id="@+id/etEditAge"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input"
        android:hint="Enter age"
        android:autofillHints="age"
        android:inputType="number"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_dark"
        android:textSize="14sp" />

    <!-- Gender RadioGroup -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gender"
        android:textColor="@color/text_dark"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_gravity="start" />

    <RadioGroup
        android:id="@+id/rgGender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="start">

        <RadioButton
            android:id="@+id/rbMale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="Male"
            android:textColor="@color/text_dark" />

        <RadioButton
            android:id="@+id/rbFemale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Female"
            android:textColor="@color/text_dark" />
    </RadioGroup>

    <!-- Job Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Job / Occupation"
        android:textColor="@color/text_dark"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_gravity="start" />

    <EditText
        android:id="@+id/etEditJob"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_input"
        android:hint="e.g., Professor / Mathematics Teacher"
        android:autofillHints="jobTitle"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_dark"
        android:textSize="14sp" />

    <!-- Save Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSaveProfile"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_blue_button"
        android:text="Save Profile &amp; Sync Vercel"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
